# Keep the published checkout limited to the Rust workspace and its images.
/*
!/.gitignore
!/README.md
!/Cargo.toml
!/Cargo.lock
!/run-client.bat
!/run-client.sh
!/rust/
!/rust/**

# Rust build output and native binaries
**/target/
**/debug/
**/release/
**/build/
**/dist/
**/out/
**/bin/
**/*.exe
**/*.dll
**/*.so
**/*.dylib
**/*.pdb
**/*.rlib
**/*.rmeta
**/*.o
**/*.obj
**/*.d

# Original Minecraft source, jars, launcher files, and generated data
**/*.java
**/*.class
**/*.jar
**/*.log
/conf/
/jars/
/libraries/
/minecraft/
/minecraft_server/
/reference/
/serv/

# Local settings and editor/OS files
.env
.env.*
!.env.example
**/.idea/
**/.vscode/
**/.settings/
**/*.iml
.DS_Store
Thumbs.db
Desktop.ini
